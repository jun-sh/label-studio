# ego-001 MCAP H.264 production profile (130 edge + 34 derive/convert).
# Applied by: ego-130-provision.sh --profile mcap-production
# Validated by: ego-station-doctor.sh ego-001

EGO_STATION_ID=ego-001
EGO_SEGMENT_ROOT=/home/server/cache/ego-001/segments
EGO_SEGMENT_ACTIVE_ROOT=/tmp/ego-001-mcap-active
EGO_CAPTURE_CHECKPOINT=/home/server/cache/ego-001/checkpoint.json
EGO_EXPORT_ROOT=/home/server/export/ego-001
EGO_UPLOAD_LOG_DIR=/home/server/cache/ego-001/logs

SEGMENT_MCAP=1
SEGMENT_FRAME_BIN=0
UPLOAD_PROTOCOL=mcap
MCAP_VIDEO_CODEC=h264

OAK_HW_JPEG=0
OAK_H264=1
SEGMENT_H264=1
EGO_CAPTURE_JPEG_ONLY=0
# Preview sizing/FPS live in ecs-record-oak-mcap.service.d/z-mcap-production.conf only.
# Do not set OAK_HW_PREVIEW_H264 in station.conf — EnvironmentFile overrides drop-ins on 130.

EGO_UPLOAD_URL=http://10.10.10.34:8080/lerobot/api/collection/stations/ego-001/upload
DATALAB_HEARTBEAT_URL=http://10.10.10.34:8080/lerobot/api/collection/stations/ego-001/upload
STATION_UPLOAD_TOKEN=dl-upload-ego-001-v1
EGO_SEGMENT_DELETE_AFTER_UPLOAD=1
EGO_NOTIFY_PROCESS=1

# 34 derive (docker derive-worker)
DERIVE_MCAP_SINGLE_FAST=1
DERIVE_EXTRACT_CONCURRENCY=4

# 34 convert (ego-process) — WiLoR repo backend (EGO_WILOR_BACKEND=repo → wilor)
EGO_WILOR_BACKEND=repo
EGO_WILOR_DEVICE=cuda:0
EGO_WILOR_REQUIRE_CUDA=1
EGO_WILOR_WARM=1
# convert_batch not shipped; use per-session convert.py until batch CLI exists.
EGO_CONVERT_BATCH=0
EGO_USE_CONVERT_WORKER=1
EGO_DEPTH_PREVIEW=1
EGO_HANDS_FRAME_STRIDE=3
