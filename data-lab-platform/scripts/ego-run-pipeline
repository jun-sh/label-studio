#!/usr/bin/env bash
# ego-run-pipeline — 34 平台单命令跑完全链路（等待就绪 → 后处理 → 发布 → 部署）
# 用法: ego-run-pipeline <station> [--reset]
set -euo pipefail

STATION=""
RESET_MODE=""
SKIP_DEPLOY=0
SKIP_GATE=0
SKIP_VIEWER_SYNC=0
for arg in "$@"; do
  case "$arg" in
    --reset|--reset-full) RESET_MODE="full" ;;
    --reset-34) RESET_MODE="34" ;;
    --skip-deploy) SKIP_DEPLOY=1 ;;
    --skip-gate) SKIP_GATE=1 ;;
    --skip-viewer-sync) SKIP_VIEWER_SYNC=1 ;;
    -h|--help)
      cat <<'EOF'
用法: ego-run-pipeline <station> [选项]

  <station>            采集站 ID，如 ego-001
  默认                 增量：只处理未发布 session，断点续跑
  --skip-deploy        跳过 deploy-local-datasets（由 ego-process 做轻量 ingest）
  --skip-gate          跳过 Viewer 发布门禁
  --skip-viewer-sync   跳过 convert 后自动轻量 Viewer sync（P-Ops-3 默认开启）
  --reset-34           仅清 34（stream/pipeline/corpus/samples），保留 214 可重传
  --reset-full         清 214 + 34 全链路（须确认）
  --reset              同 --reset-full（兼容旧用法）

对外交付请优先使用: ego-deliver <station> 或 ego-process <station>

环境变量（oak 子模块覆盖，一般无需设置）:
  EGO_HANDS_FORCE=1
  EGO_WILOR_BACKEND=repo
  EGO_HAMER_BACKEND=geopavlakos
  WILOR_ROOT=<ego-hand-pipeline>/third_party/wilor
  WILOR_IMPL=repo
EOF
      exit 0
      ;;
    -*)
      echo "❌ 未知参数: $arg" >&2
      exit 2
      ;;
    *)
      if [[ -z "$STATION" ]]; then
        STATION="$arg"
      else
        echo "❌ 多余参数: $arg" >&2
        exit 2
      fi
      ;;
  esac
done

[[ -n "$STATION" ]] || {
  echo "❌ 请指定采集站，例如: ego-run-pipeline ego-001" >&2
  exit 2
}

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=ego-pipeline-performance.env.sh
source "${SCRIPT_DIR}/ego-pipeline-performance.env.sh"
DATALAB_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
PIPE_ROOT="${EGO_HAND_PIPELINE_ROOT:-$(dirname "$DATALAB_ROOT")/ego-hand-pipeline}"
PLATFORM_ROOT="${EGO_PLATFORM_ROOT:-$(dirname "$DATALAB_ROOT")/ego-platform}"
WILOR_ROOT="${WILOR_ROOT:-$PIPE_ROOT/third_party/wilor}"
export WILOR_ROOT WILOR_IMPL="${WILOR_IMPL:-repo}"
export EGO_WILOR_BACKEND="${EGO_WILOR_BACKEND:-repo}"
export EGO_WILOR_DEVICE="${EGO_WILOR_DEVICE:-cuda:0}"
export EGO_HAMER_BACKEND="${EGO_HAMER_BACKEND:-}"
export EGO_HAMER_DEVICE="${EGO_HAMER_DEVICE:-${EGO_WILOR_DEVICE:-cuda:0}}"
PIPELINE_BACKEND="${EGO_PIPELINE_BACKEND:-oak}"
OAK_MODE="${EGO_OAK_MODE:-hands}"
export EGO_OAK_TRACK_MODE="${EGO_OAK_TRACK_MODE:-vio}"
export EGO_OAK_LANGUAGE_MODE="${EGO_OAK_LANGUAGE_MODE:-auto}"
export EGO_OAK_DEPTH_BACKEND="${EGO_OAK_DEPTH_BACKEND:-depth_anything_v2}"
export EGO_DEPTH_ANYTHING_MODEL="${EGO_DEPTH_ANYTHING_MODEL:-depth-anything/Depth-Anything-V2-Small-hf}"
EGO_WILOR_BACKEND="${EGO_WILOR_BACKEND:-repo}"
PLATFORM_PYTHON="python3"
_venv_py="$PIPE_ROOT/.venv/bin/python3"
if [[ -x "$_venv_py" ]]; then
  if [[ "$PIPELINE_BACKEND" == "oak" && "$EGO_WILOR_BACKEND" == "repo" ]]; then
    PLATFORM_PYTHON="$_venv_py"
  elif [[ "$PIPELINE_BACKEND" == "oak" && "$EGO_OAK_DEPTH_BACKEND" == "depth_anything_v2" ]] \
    && "$_venv_py" -c "import transformers" 2>/dev/null; then
    PLATFORM_PYTHON="$_venv_py"
  fi
fi
SESSIONS_PY="${SCRIPT_DIR}/ego-pipeline-sessions.py"
WAIT_SH="${SCRIPT_DIR}/ego-wait-ready-for-postprocess.sh"
RESET_SH="${SCRIPT_DIR}/ego-001-reset-for-rerun.sh"
RESET_34_SH="${SCRIPT_DIR}/ego-reset-34-only.sh"
DEPLOY_SH="${DATALAB_ROOT}/data-lab-platform/deploy-local-datasets.sh"
POSTPROCESS_SH="${PIPE_ROOT}/scripts/ego-postprocess.sh"
VIEWER_SYNC_SH="${SCRIPT_DIR}/ego-viewer-sync.sh"
AUTO_VIEWER_SYNC="${EGO_AUTO_VIEWER_SYNC:-1}"

PLATFORM_HOST="${LABEL_STUDIO_HOST:-http://10.10.10.34:8080}"
PLATFORM_HOST="${PLATFORM_HOST%/}"

LOG_DIR="${DATALAB_ROOT}/data-storage/logs"
mkdir -p "$LOG_DIR"
RUN_LOG="${LOG_DIR}/ego-run-pipeline-${STATION}-$(date +%Y%m%d-%H%M%S).log"

log() { echo "[pipeline] $*" | tee -a "$RUN_LOG"; }
die() { echo "❌ $*" | tee -a "$RUN_LOG" >&2; exit 1; }

_py() {
  PYTHONPATH="${PLATFORM_ROOT}/src:${PYTHONPATH:-}" python3 "$SESSIONS_PY" "$@" --datalab-root "$DATALAB_ROOT" --pipe-root "$PIPE_ROOT" --backend "$PIPELINE_BACKEND"
}

_run_oak_convert_session() {
  local SID="$1"
  local _convert_force=()
  if [[ "${EGO_HANDS_FORCE:-}" == "1" ]]; then
    _convert_force=(--force)
  fi
  log ">>> 后处理 ${STATION} / ${SID} (IMU: sensor_raw/imu)"
  set +e
  (
    cd "$PLATFORM_ROOT" && \
    PYTHONPATH="${PLATFORM_ROOT}/src:${PYTHONPATH:-}" \
    DATALAB_ROOT="$DATALAB_ROOT" WILOR_ROOT="$WILOR_ROOT" \
    "$PLATFORM_PYTHON" -m ego_platform.cli.convert \
      --station "$STATION" \
      --session "$SID" \
      --datalab-root "$DATALAB_ROOT" \
      --corpus-slug "$SLUG" \
      --mode "$OAK_MODE" \
      "${_convert_force[@]}"
  ) 2>&1 | tee -a "$RUN_LOG"
  local rc=${PIPESTATUS[0]}
  set -e
  return "$rc"
}

_count_convert_markers() {
  local SID="$1"
  local DONE_MARKER="${DATALAB_ROOT}/data-storage/pipeline/${STATION}/${SID}/.status/finalize.done"
  if [[ -f "$DONE_MARKER" ]]; then
    PROCESSED=$((PROCESSED + 1))
    log "session ${SID} 完成"
  else
    FAILED=$((FAILED + 1))
    log "session ${SID} 未完成 (缺少 ${DONE_MARKER})"
  fi
}

_convert_worker_pidfile() {
  echo "${DATALAB_ROOT}/data-storage/pipeline/.convert-worker-${STATION}.pid"
}

_convert_worker_heartbeat() {
  echo "${DATALAB_ROOT}/data-storage/pipeline/.convert-worker-${STATION}.heartbeat"
}

_reclaim_stale_convert_worker() {
  [[ "${EGO_USE_CONVERT_WORKER:-0}" == "1" ]] || return 0
  local pf hb pid stale_sec opid
  stale_sec="${EGO_CONVERT_WORKER_STALE_SEC:-1800}"
  pf="$(_convert_worker_pidfile)"
  hb="$(_convert_worker_heartbeat)"
  [[ -f "$pf" ]] || return 0
  pid="$(tr -d '[:space:]' < "$pf" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 0

  mapfile -t _pending_check < <(_py pending "$STATION" 2>/dev/null || true)
  [[ ${#_pending_check[@]} -gt 0 ]] || return 0

  if [[ ! -f "$hb" ]]; then
    log "convert worker pid ${pid} has pending work but no heartbeat — restarting"
  else
    local hb_mtime now age
    hb_mtime="$(stat -c %Y "$hb" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    age=$((now - hb_mtime))
    if (( age < stale_sec )); then
      return 0
    fi
    log "convert worker stale (${age}s > ${stale_sec}s) with pending ${#_pending_check[@]} — restarting pid ${pid}"
  fi
  kill -TERM "$pid" 2>/dev/null || true
  sleep 2
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$pf"
  while read -r opid; do
    [[ -z "$opid" || "$opid" == "$pid" ]] && continue
    kill -TERM "$opid" 2>/dev/null || true
  done < <(pgrep -f "ego-convert-worker\\.sh[[:space:]]+${STATION}(\\s|$)" 2>/dev/null || true)
}

_reclaim_convert_worker_orphans() {
  local pf pid opid
  pf="$(_convert_worker_pidfile)"
  pid=""
  if [[ -f "$pf" ]]; then
    pid="$(tr -d '[:space:]' < "$pf" 2>/dev/null || true)"
  fi
  while read -r opid; do
    [[ -z "$opid" ]] && continue
    [[ -n "$pid" && "$opid" == "$pid" ]] && continue
    if kill -0 "$opid" 2>/dev/null; then
      log "stopping orphan convert worker pid ${opid}"
      kill -TERM "$opid" 2>/dev/null || true
    fi
  done < <(pgrep -f "ego-convert-worker\\.sh[[:space:]]+${STATION}(\\s|$)" 2>/dev/null || true)
}

_ensure_convert_worker() {
  [[ "${EGO_USE_CONVERT_WORKER:-0}" == "1" ]] || return 0
  local pf
  pf="$(_convert_worker_pidfile)"
  _reclaim_convert_worker_orphans
  _reclaim_stale_convert_worker
  if [[ -f "$pf" ]]; then
    local pid
    pid="$(tr -d '[:space:]' < "$pf" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      log "convert worker already running (pid ${pid})"
      return 0
    fi
  fi
  log "启动 convert worker（WiLoR 常驻）…"
  nohup bash "${SCRIPT_DIR}/ego-convert-worker.sh" "$STATION" >> "${LOG_DIR}/ego-convert-worker-${STATION}.log" 2>&1 &
}

_wait_convert_worker_drain() {
  local timeout_sec="${EGO_CONVERT_WORKER_WAIT_SEC:-7200}"
  local deadline=$((SECONDS + timeout_sec))
  local started=$SECONDS
  mapfile -t _drain_initial < <(_py awaiting "$STATION" 2>/dev/null || true)
  local total=${#_drain_initial[@]}
  [[ "$total" -gt 0 ]] || return 0
  while (( SECONDS < deadline )); do
    mapfile -t AWAITING < <(_py awaiting "$STATION" 2>/dev/null || true)
    if [[ ${#AWAITING[@]} -eq 0 ]]; then
      log "convert worker 完成 ${total}/${total}（$((SECONDS - started))s）"
      return 0
    fi
    local done=$((total - ${#AWAITING[@]}))
    log "convert 进度 finalize ${done}/${total} 已等待 $((SECONDS - started))s 待处理: ${AWAITING[*]}"
    sleep 5
  done
  die "convert worker 等待超时（${timeout_sec}s）"
}

_wait_session_parquet_ready() {
  local timeout_sec="${WAIT_PARQUET_SEC:-1800}"
  local interval_sec="${WAIT_PARQUET_INTERVAL_SEC:-5}"
  local fail_fast_sec="${EGO_PARQUET_FAIL_FAST_SEC:-120}"
  local deadline=$((SECONDS + timeout_sec))
  local started=$SECONDS
  log "等待各 session derive parquet 就绪（超时 ${timeout_sec}s，fail-fast ${fail_fast_sec}s）…"

  mapfile -t FAILED < <(find "${DATALAB_ROOT}/data-storage/stream/${STATION}/state/sessions" -name 'session.FAILED' 2>/dev/null \
    | while read -r f; do basename "$(dirname "$f")"; done | sort -u)
  if [[ ${#FAILED[@]} -gt 0 ]]; then
    die "derive 阻塞：存在 FAILED session: ${FAILED[*]}"
  fi

  while (( SECONDS < deadline )); do
    mapfile -t BLOCKERS < <(_py parquet-blockers "$STATION" 2>/dev/null || true)
    if [[ ${#BLOCKERS[@]} -eq 0 ]]; then
      return 0
    fi
    local elapsed=$((SECONDS - started))
    if (( elapsed >= fail_fast_sec )); then
      mapfile -t PENDING_DERIVE < <(_py derive-pending "$STATION" 2>/dev/null || true)
      if [[ ${#PENDING_DERIVE[@]} -gt 0 ]]; then
        die "derive 未完成（${elapsed}s）：待 derive ${PENDING_DERIVE[*]}；待 parquet ${BLOCKERS[*]}"
      fi
    fi
    log "derive 进行中，待 parquet (${elapsed}s): ${BLOCKERS[*]}"
    sleep "$interval_sec"
  done
  die "等待 session parquet 超时（${timeout_sec}s）— 待处理: $(_py parquet-blockers "$STATION" 2>/dev/null | tr '\n' ' ')"
}

if [[ "$RESET_MODE" == "34" ]]; then
  log "重置模式：仅清 34 平台数据（保留 214 段文件可重传）"
  if [[ "${EGO_RESET_YES:-}" != "1" ]]; then
    echo "⚠️  将删除 34 上 stream / pipeline / corpus / samples。"
    read -r -p "确认 --reset-34？[y/N] " ans
    [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || { echo "已取消"; exit 0; }
  fi
  STATION_ID="$STATION" EGO_RESET_YES=1 bash "$RESET_34_SH" 2>&1 | tee -a "$RUN_LOG"
  log "34 清场完成"
elif [[ "$RESET_MODE" == "full" ]]; then
  log "重置模式：将清空 214 + 34 全链路数据后重新处理"
  if [[ "${EGO_RESET_YES:-}" != "1" ]]; then
    echo "⚠️  此操作会删除该站所有采集、后处理、Viewer 数据，无法撤销。"
    read -r -p "确认 --reset-full？[y/N] " ans
    [[ "${ans,,}" == "y" || "${ans,,}" == "yes" ]] || { echo "已取消"; exit 0; }
  fi
  STATION_ID="$STATION" EGO_RESET_YES=1 bash "$RESET_SH" 2>&1 | tee -a "$RUN_LOG"
  log "全链路重置完成"
fi

mapfile -t RECONCILED < <(_py reconcile-markers "$STATION" 2>/dev/null || true)
if [[ ${#RECONCILED[@]} -gt 0 ]]; then
  log "已清理陈旧 pipeline marker: ${RECONCILED[*]}"
fi

if [[ "$PIPELINE_BACKEND" == "legacy" ]]; then
  die "PIPELINE_BACKEND=legacy 已废弃，请使用默认 oak 后端（WiLoR convert）"
fi
if [[ "$PIPELINE_BACKEND" == "oak" && ! -d "$PLATFORM_ROOT" ]]; then
  die "找不到 ego-platform: $PLATFORM_ROOT"
fi

HAS_DATA=0
if _py has-data "$STATION"; then HAS_DATA=1; fi

mapfile -t PENDING < <(_py pending "$STATION" 2>/dev/null || true)
SLUG="$(_py slug "$STATION" 2>/dev/null || echo "ego_001")"
MANIFEST_ID="$(_py manifest-id "$STATION" 2>/dev/null || echo "ego-001")"
VIEWER_URL="${PLATFORM_HOST}/data/${MANIFEST_ID}"
COLLECTION_URL="${PLATFORM_HOST}/collection?station=${STATION}"

if [[ "$HAS_DATA" -eq 0 && ${#PENDING[@]} -eq 0 ]]; then
  die "采集页还没有数据。请先在 ${COLLECTION_URL} 导入 .tar.zst 包，再执行本命令。"
fi

if [[ "$HAS_DATA" -eq 1 ]]; then
  STREAM_ROOT="${DATALAB_ROOT}/data-storage/stream/${STATION}"
  INTR_CHECK="$(
    PYTHONPATH="${PLATFORM_ROOT}/src:${PYTHONPATH:-}" python3 -c "
from pathlib import Path
from ego_platform.lerobot.publish_gate import validate_stream_intrinsics
r = validate_stream_intrinsics(Path('${STREAM_ROOT}'))
if not r.get('ok'):
    print('; '.join(r.get('errors') or ['intrinsics check failed']))
" 2>/dev/null || true
  )"
  if [[ -n "$INTR_CHECK" ]]; then
    die "stream 内参门禁未通过: ${INTR_CHECK}"
  fi
  log "等待流数据合并完成（视频+表格就绪）…"
  STATION_ID="$STATION" bash "$WAIT_SH" 2>&1 | tee -a "$RUN_LOG"
  _wait_session_parquet_ready 2>&1 | tee -a "$RUN_LOG"
fi

PROCESSED=0
FAILED=0
if [[ ${#PENDING[@]} -gt 0 ]]; then
  log "待处理 session: ${PENDING[*]} (backend=${PIPELINE_BACKEND}, oak_mode=${OAK_MODE}, batch=${EGO_CONVERT_BATCH:-0}, parallel=${EGO_CONVERT_PARALLEL:-1}, worker=${EGO_USE_CONVERT_WORKER:-0})"
  if [[ "${EGO_USE_CONVERT_WORKER:-0}" == "1" ]]; then
    _ensure_convert_worker
    log "等待 convert worker 消化 ${#PENDING[@]} 个 session…"
    _wait_convert_worker_drain
    for SID in "${PENDING[@]}"; do
      _count_convert_markers "$SID"
    done
  elif [[ "$PIPELINE_BACKEND" == "oak" && "${EGO_CONVERT_BATCH:-0}" != "0" && ${#PENDING[@]} -gt 1 ]]; then
    if ! (
      cd "$PLATFORM_ROOT" && \
      PYTHONPATH="${PLATFORM_ROOT}/src:${PYTHONPATH:-}" \
      "$PLATFORM_PYTHON" -c "import ego_platform.cli.convert_batch" 2>/dev/null
    ); then
      log "batch convert 不可用（缺少 ego_platform.cli.convert_batch），回退单 session convert"
      for SID in "${PENDING[@]}"; do
        set +e
        _run_oak_convert_session "$SID"
        rc=$?
        set -e
        if [[ "$rc" -ne 0 ]]; then
          log "session ${SID} 失败 (exit ${rc})"
          FAILED=$((FAILED + 1))
          continue
        fi
        _count_convert_markers "$SID"
      done
    else
    log "batch convert（WiLoR 模型常驻，单进程多 session）…"
    _convert_force=()
    if [[ "${EGO_HANDS_FORCE:-}" == "1" ]]; then
      _convert_force=(--force)
    fi
    set +e
    (
      cd "$PLATFORM_ROOT" && \
      PYTHONPATH="${PLATFORM_ROOT}/src:${PYTHONPATH:-}" \
      "$PLATFORM_PYTHON" -m ego_platform.cli.convert_batch \
        --station "$STATION" \
        --sessions "${PENDING[@]}" \
        --datalab-root "$DATALAB_ROOT" \
        --corpus-slug "$SLUG" \
        --mode "$OAK_MODE" \
        "${_convert_force[@]}"
    ) 2>&1 | tee -a "$RUN_LOG"
    batch_rc=${PIPESTATUS[0]}
    set -e
    if [[ "$batch_rc" -ne 0 ]]; then
      log "batch convert 退出码 ${batch_rc}，按 session 检查 finalize marker"
    fi
    for SID in "${PENDING[@]}"; do
      _count_convert_markers "$SID"
    done
    fi
  elif [[ "$PIPELINE_BACKEND" == "oak" && "${EGO_CONVERT_PARALLEL:-1}" -gt 1 ]]; then
    log "parallel convert（workers=${EGO_CONVERT_PARALLEL}，每 worker 独立加载 WiLoR）…"
    _pids=()
    for SID in "${PENDING[@]}"; do
      while (( $(jobs -r 2>/dev/null | wc -l) >= EGO_CONVERT_PARALLEL )); do
        wait -n 2>/dev/null || wait || true
      done
      _run_oak_convert_session "$SID" &
      _pids+=($!)
    done
    for pid in "${_pids[@]}"; do
      wait "$pid" || true
    done
    for SID in "${PENDING[@]}"; do
      _count_convert_markers "$SID"
    done
  elif [[ "$PIPELINE_BACKEND" != "oak" ]]; then
    for SID in "${PENDING[@]}"; do
      log ">>> legacy 后处理 ${STATION} / ${SID}"
      set +e
      (cd "$PIPE_ROOT" && bash "$POSTPROCESS_SH" "$STATION" "$SID") 2>&1 | tee -a "$RUN_LOG"
      rc=${PIPESTATUS[0]}
      set -e
      DONE_MARKER="${PIPE_ROOT}/outputs/${STATION}/${SID}/.status/publish.done"
      if [[ "$rc" -ne 0 ]]; then
        log "session ${SID} 失败 (exit ${rc})"
        FAILED=$((FAILED + 1))
        continue
      fi
      if [[ -f "$DONE_MARKER" ]]; then
        PROCESSED=$((PROCESSED + 1))
        log "session ${SID} 完成"
      else
        FAILED=$((FAILED + 1))
        log "session ${SID} 未完成 (缺少 ${DONE_MARKER})"
      fi
    done
  else
    for SID in "${PENDING[@]}"; do
      set +e
      _run_oak_convert_session "$SID"
      rc=$?
      set -e
      if [[ "$rc" -ne 0 ]]; then
        log "session ${SID} 失败 (exit ${rc})"
        FAILED=$((FAILED + 1))
        continue
      fi
      _count_convert_markers "$SID"
    done
  fi
else
  log "所有 session 已发布，跳过后处理"
fi

if [[ "$FAILED" -gt 0 ]]; then
  die "有 ${FAILED} 个 session 处理失败。修复后重新执行同一条命令即可断点续跑。日志: ${RUN_LOG}"
fi

SAMPLES_ZIP="${DATALAB_ROOT}/data-storage/samples/${SLUG}.zip"
if [[ ! -f "$SAMPLES_ZIP" && "$PROCESSED" -eq 0 && "$SKIP_DEPLOY" -eq 0 ]]; then
  die "没有可部署的数据集 zip（${SAMPLES_ZIP}）。请先完成上传和后处理。"
fi

if [[ "$SKIP_DEPLOY" -eq 0 ]]; then
  log "部署 Viewer…"
  if [[ -x "$DEPLOY_SH" ]]; then
    (cd "$DATALAB_ROOT" && bash "$DEPLOY_SH") 2>&1 | tee -a "$RUN_LOG"
  else
    die "找不到部署脚本: $DEPLOY_SH"
  fi
else
  log "跳过 full deploy（--skip-deploy）"
fi

VIEWER_SYNCED=0
VIEWER_GATE_OK=1
GATE_SH="${SCRIPT_DIR}/ego-viewer-publish-gate.sh"
if [[ "$SKIP_GATE" -eq 0 && -x "$GATE_SH" && -f "$SAMPLES_ZIP" ]]; then
  log "Viewer 发布门禁（内参 + rectify + 720p + B7）…"
  set +e
  EGO_STATION="$STATION" bash "$GATE_SH" "$SLUG" 2>&1 | tee -a "$RUN_LOG"
  gate_rc=${PIPESTATUS[0]}
  set -e
  if [[ "$gate_rc" -ne 0 ]]; then
    VIEWER_GATE_OK=0
    log "⚠️  Viewer publish gate 未通过 — 跳过 HTTP sync"
  fi
fi

if [[ "$PROCESSED" -gt 0 && "$SKIP_DEPLOY" -eq 1 && "$SKIP_VIEWER_SYNC" -eq 0 && "$AUTO_VIEWER_SYNC" != "0" && "$VIEWER_GATE_OK" -eq 1 ]]; then
  if [[ -x "$VIEWER_SYNC_SH" ]]; then
    log "自动 Viewer sync（convert 完成，P-Ops-3）…"
    if bash "$VIEWER_SYNC_SH" 2>&1 | tee -a "$RUN_LOG"; then
      VIEWER_SYNCED=1
      log "自动 Viewer sync 完成"
    else
      log "⚠️  Viewer sync 失败（可稍后 ego-viewer-sync.sh）"
    fi
  fi
fi

echo ""
echo "════════════════════════════════════════"
echo "✅ 流水线完成"
echo "   站点的:     ${STATION}"
echo "   新处理:     ${PROCESSED} 个 session"
echo "   采集质检:   ${COLLECTION_URL}"
echo "   数据集:     ${VIEWER_URL}"
echo "   日志:       ${RUN_LOG}"
echo "════════════════════════════════════════"
