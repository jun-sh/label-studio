[Unit]
Description=EGO OAK standby stack (idle preview probe; no capture)
Documentation=file:///home/server/workspace/ego-studio/README.md
After=network-online.target
Wants=network-online.target
Wants=ecs-preview-standby.service
Wants=ecs-station-heartbeat.service
Conflicts=ecs-record-oak-stream.service ecs-record-oak-mcap.service ecs-oak-capture-stack.target ecs-oak-mcap-capture-stack.target

[Install]
WantedBy=default.target
