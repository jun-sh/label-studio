[Unit]
Description=EGO OAK capture-only (Scheme A: local segments + MJPEG preview)
Documentation=file:///home/server/workspace/ego-studio/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/server/workspace/ego-studio

Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/server/workspace/ego-studio/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATALAB_HEARTBEAT_URL=http://10.10.10.34:8080/lerobot/api/collection/stations/ego-lan-214/upload
Environment=STATION_UPLOAD_TOKEN=dl-upload-ego-lan-214-v1
Environment=DATALAB_CAPTURE_HOST=10.10.10.214
Environment=EGO_SEGMENT_ROOT=/home/server/cache/ego-lan-214/segments
Environment=EGO_SEGMENT_QUOTA_GB=256
Environment=EGO_SEGMENT_MAX_FRAMES=300
Environment=EGO_SEGMENT_MAX_SECONDS=45
Environment=EGO_SEGMENT_MAX_PENDING=10
Environment=SEGMENT_AUTO_PURGE_PENDING=1
Environment=SEGMENT_BACKPRESSURE_PENDING=1
Environment=EGO_CAPTURE_CHECKPOINT=/home/server/cache/ego-lan-214/segments/checkpoint.json
Environment=DATALAB_JPEG_QUALITY=70
Environment=OPENCV_NUM_THREADS=2
Environment=CAPTURE_JPEG_MAX_EDGE=0
Environment=PREVIEW_FPS=8
Environment=PREVIEW_MAX_EDGE=640
Environment=PREVIEW_JPEG_QUALITY=75

ExecStart=/home/server/workspace/ego-studio/.venv/bin/python -m ego_capture_studio.cli.record_oak_stream \
  --fps 30 --imu-hz 200

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecs-record-oak-stream

[Install]
WantedBy=ecs-oak-capture-stack.target
