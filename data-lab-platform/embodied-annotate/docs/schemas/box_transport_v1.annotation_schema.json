      "subgoal_zh": "趋近目标箱体并准备抓取"
    },
    {
      "id": "grasp_skill",
      "order": 1,
      "color": "#F59E0B",
      "label_zh": "抓取技能",
      "label_en": "Grasp",
      "hint_zh": "预抓 → 接触 → 抬升离地",
