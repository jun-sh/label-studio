#!/usr/bin/env bash
# ego-deliver — 214 上传 → 34 派生等待 → 后处理 → Viewer 发布（一条命令）
set -euo pipefail

STATION=""
RESET_MODE=""
for arg in "$@"; do
  case "$arg" in
    --reset-34) RESET_MODE="34" ;;
    --reset-full|--reset) RESET_MODE="full" ;;
    -h|--help) STATION="" ;;
    -*)
      echo "未知参数: $arg" >&2
      exit 2
      ;;
    *)
      if [[ -z "$STATION" ]]; then
        STATION="$arg"
      else
        echo "多余参数: $arg" >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -z "$STATION" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
用法: ego-deliver <station> [选项]

录完后在 34 上执行的唯一交付命令:
  1. 214 上传待传 segment
  2. 34 等待派生（LeRobot parquet + MP4）
  3. 后处理（畸变校正 / 手部骨架 / 深度 / 发布）
  4. 部署 Viewer（内参 + rectify 硬门禁）

示例:
  ego-deliver ego-lan-214
  ego-deliver ego-lan-214 --reset-34    # 仅清 34，从 214 重传
  ego-deliver ego-lan-214 --reset-full  # 清 214 + 34（慎用）

环境变量:
  EDGE_HOST            默认 server@10.10.10.214
  DERIVE_TIMEOUT_SEC   默认 3600
  EGO_RESET_YES=1      跳过 reset 确认
EOF
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATALAB_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
EDGE_HOST="${EDGE_HOST:-server@10.10.10.214}"
DERIVE_TIMEOUT_SEC="${DERIVE_TIMEOUT_SEC:-3600}"
PLATFORM_HOST="${LABEL_STUDIO_HOST:-http://10.10.10.34:8080}"
PLATFORM_HOST="${PLATFORM_HOST%/}"

log() { echo "[deliver] $*"; }
die() { echo "[deliver] ERROR: $*" >&2; exit 1; }

SLUG="$(python3 "${SCRIPT_DIR}/ego-pipeline-sessions.py" slug "$STATION" \
  --datalab-root "$DATALAB_ROOT" 2>/dev/null || echo "ego_214_hand_pose")"
VIEWER_URL="${PLATFORM_HOST}/data/${SLUG}"

if [[ "$RESET_MODE" == "34" ]]; then
  log "=== 0/3 清场 (仅 34) ==="
  STATION_ID="$STATION" EGO_RESET_YES="${EGO_RESET_YES:-}" bash "${SCRIPT_DIR}/ego-lan-214-reset-34-only.sh"
elif [[ "$RESET_MODE" == "full" ]]; then
  log "=== 0/3 清场 (214 + 34) ==="
  STATION_ID="$STATION" EGO_RESET_YES="${EGO_RESET_YES:-}" bash "${SCRIPT_DIR}/ego-lan-214-reset-for-rerun.sh"
fi

log "=== 1/3 214 上传待传 segment ==="
ssh -o BatchMode=yes "${EDGE_HOST}" bash -s <<'REMOTE'
set -euo pipefail
PY="${EGO_PYTHON:-/home/server/workspace/ego-studio/.venv/bin/python}"
SEG_ROOT="${EGO_SEGMENT_ROOT:-/home/server/cache/ego-lan-214/segments}"
uploaded=0
for sess_dir in "${SEG_ROOT}/sessions"/sess_*/; do
  [[ -d "$sess_dir" ]] || continue
  sid="$(basename "$sess_dir")"
  if "$PY" -c "
from pathlib import Path
from ego_capture_studio.capture.segment_store import list_closed_pending_segments
root = Path('${SEG_ROOT}')
pending = list_closed_pending_segments(root, '${sid}')
raise SystemExit(0 if pending else 1)
" 2>/dev/null; then
    echo "[214] uploading ${sid}..."
    "$PY" -m ego_capture_studio.cli.ego_upload --source segments --session-id "$sid" --no-live-ui
    uploaded=$((uploaded + 1))
  fi
done
READY_ROOT="${EGO_EXPORT_ROOT:-/home/server/export/ego-lan-214}/ready"
if [[ -d "$READY_ROOT" ]]; then
  latest="$(find "$READY_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r | head -1 || true)"
  if [[ -n "$latest" ]] && compgen -G "${latest}"/sess_*__seg_*.tar.zst >/dev/null; then
    echo "[214] uploading ready archives from ${latest}..."
    "$PY" -m ego_capture_studio.cli.ego_upload --source ready --ready-dir "$latest" --no-live-ui || true
    uploaded=$((uploaded + 1))
  fi
fi
if [[ "$uploaded" -eq 0 ]]; then
  echo "[214] nothing to upload (segments already sent or no closed segments)"
fi
REMOTE

log "=== 2/3 等待 34 派生（LeRobot + MP4）==="
deadline=$(( $(date +%s) + DERIVE_TIMEOUT_SEC ))
STREAM="${DATALAB_ROOT}/data-storage/stream/${STATION}"
last_pct=""
while (( $(date +%s) < deadline )); do
  status_json="$(curl -sf "${PLATFORM_HOST}/lerobot/api/collection/stations/${STATION}/derive-status" 2>/dev/null || echo '{}')"
  read -r pct markers total phase parquet_rows <<<"$(
    python3 -c "
import json,sys
d=json.loads(sys.argv[1]) if len(sys.argv)>1 else {}
p=d.get('progress') or {}
print(p.get('percent',0), p.get('markers',0), p.get('total',0), d.get('phase','?'), p.get('parquetRows',0))
" "$status_json" 2>/dev/null || echo "0 0 0 ? 0"
  )"
  line="$(date +%H:%M:%S) derive ${pct}% markers=${markers}/${total} phase=${phase} parquetRows=${parquet_rows}"
  if [[ "$line" != "$last_pct" ]]; then
    log "$line"
    last_pct="$line"
  fi
  if [[ -f "${STREAM}/meta/info.json" && -f "${STREAM}/data/chunk-000/file-000.parquet" ]] \
    && find "${STREAM}/videos" -name '*.mp4' -print -quit 2>/dev/null | grep -q .; then
    if [[ "${total:-0}" -gt 0 && "${pct:-0}" -ge 100 ]]; then
      log "派生完成"
      break
    fi
    if [[ "${total:-0}" -eq 0 && "$(python3 -c "import json; print(json.load(open('${STREAM}/meta/info.json')).get('total_frames',0))" 2>/dev/null || echo 0)" -gt 0 ]]; then
      log "派生完成（stream 已有数据）"
      break
    fi
  fi
  sleep 20
done
if (( $(date +%s) >= deadline )); then
  die "派生超时 ${DERIVE_TIMEOUT_SEC}s — 查 derive-status 或 derive-worker 日志"
fi

log "=== 3/3 后处理 + 发布 Viewer ==="
bash "${SCRIPT_DIR}/ego-run-pipeline" "$STATION"

log "交付完成 → ${VIEWER_URL}"
