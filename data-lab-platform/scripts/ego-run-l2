#!/usr/bin/env bash
# ego-run-l2 — L2 rectified 1280×800 corpus append (no WiLoR / algorithm sidecars).
set -euo pipefail

STATION="${1:-}"
if [[ -z "$STATION" || "$STATION" == "-h" || "$STATION" == "--help" ]]; then
  cat <<'EOF'
用法: ego-run-l2 <station>

  L2 干净语料路径（产品默认热路径）:
  derive 已完成 session → L2 convert → corpus (1280×800; fisheye=rectify, pinhole=passthrough)
  append 时自动合并 derived/*/imu.parquet → corpus/sensor_raw/imu (200Hz)
  不跑 WiLoR / MANO；算法 sidecar 不进 corpus（由 ego-viewer-preview 写 samples/）。
  Viewer publish gate 在 L2 convert 内跳过，仅在 ego-process 的 L3 之后执行一次。

环境变量:
  EGO_L2_PUBLISH=1          默认由本脚本设置
  EGO_CAMERA_OPTICS           station profile SSOT (fisheye|pinhole)
  EGO_OAK_MODE                profile 或按 optics 推导（pinhole→passthrough）
  EGO_USE_CONVERT_WORKER=0  默认由本脚本设置
EOF
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=ego-station-profile-env.sh
source "${SCRIPT_DIR}/ego-station-profile-env.sh"
# shellcheck source=ego-pipeline-performance.env.sh
source "${SCRIPT_DIR}/ego-pipeline-performance.env.sh"

ego_apply_station_profile_exports "$STATION" || true
export EGO_OAK_MODE="$(ego_l2_oak_mode)"
export EGO_L2_PUBLISH=1
export EGO_USE_CONVERT_WORKER=0
export EGO_VIEWER_PUBLISH_L2=1
export EGO_AUTO_VIEWER_SYNC=0
export EGO_CONVERT_PARALLEL=1

exec bash "${SCRIPT_DIR}/ego-run-pipeline" "$STATION" --skip-deploy --skip-gate