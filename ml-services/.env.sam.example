# Copy to .env.sam and adjust values.
#
# Boot policy: 0 = do not autostart SAM / occupy GPU at reboot (default, production).
# Set to 1 only if this host is dedicated to interactive SAM labeling.
# SAM_BOOT_AUTOSTART=0
#   cp ml-services/.env.sam.example ml-services/.env.sam
#
# API key: Account & Settings → Access Token (legacy Token xxx).
# If SAM returns 401 when fetching images, ensure the org allows legacy tokens
# (Data Lab admin) or use a JWT refresh token with Bearer auth.

# Label Studio (Data Lab) — must be reachable from this host
LABEL_STUDIO_URL=http://10.10.10.34:8080
LABEL_STUDIO_API_KEY=<your-access-token-from-account-settings>

# SAM 2.1 model (paths relative to ml-services/sam2 when started from that directory)
DEVICE=cuda
MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
MODEL_CHECKPOINT=sam2.1_hiera_large.pt

# GPU index for SAM only (unset in start script defaults to 0). Stop backend before changing.
# CUDA_VISIBLE_DEVICES=0

# ML backend server
PORT=9090
WORKERS=1
THREADS=4
LOG_LEVEL=INFO

# Optional basic auth for ML backend
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
