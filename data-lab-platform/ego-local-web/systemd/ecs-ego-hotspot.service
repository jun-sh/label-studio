[Unit]
Description=EGO collection WiFi hotspot
Documentation=file:///home/server/ego-web/README.md
After=ecs-ego-wifi-radio.service NetworkManager.service network-online.target
Wants=NetworkManager.service
Before=ecs-ego-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/ego-hotspot
ExecStartPre=/home/server/ego-web/ego-hotspot-boot-wait.sh
ExecStart=/home/server/ego-web/ego-hotspot-up.sh
ExecStop=/home/server/ego-web/ego-hotspot-down.sh

[Install]
WantedBy=multi-user.target
