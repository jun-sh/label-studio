# EGO strict 20Hz production default (ego-lan-214 reference; copy into systemd drop-ins).
# Sign-off: config/strict20hz_production_signoff.json

# --- ecs-record-oak-stream (z-strict-20hz.conf) ---
EGO_STRICT_20HZ=1
EGO_IMU_INTERPOLATE=1
EGO_FRAME_INTERVAL_MS=50
EGO_STRICT_EPISODE_SECONDS=86400
EGO_CAPTURE_NO_HEARTBEAT=1
STRICT_IMU_BUFFER_MAX=2000
STRICT_SYNC_MISS_MAX=24
SEGMENT_AUTO_PURGE_PENDING=0
SEGMENT_PERSIST_WORKERS=1
SEGMENT_BACKPRESSURE_PENDING=0
EGO_PENDING_FAST_RESCAN_S=30

# --- ecs-upload-segments-loop ---
EGO_UPLOAD_KEEP_PENDING_BELOW=22
EGO_UPLOAD_TRIM_BATCH=1
EGO_SEGMENT_ASYNC_DELETE=1
EGO_UPLOAD_FAIL_DEQUEUE=1
EGO_SEGMENT_DELETE_AFTER_UPLOAD=1

# --- ecs-station-heartbeat ---
DATALAB_HEARTBEAT_INTERVAL_S=15
DATALAB_HEARTBEAT_TIMEOUT_S=3
DATALAB_HEARTBEAT_NICE=10
