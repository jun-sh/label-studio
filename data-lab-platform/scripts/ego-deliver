#!/usr/bin/env bash
# ego-deliver — edge upload → 34 derive + postprocess → Viewer publish
set -euo pipefail

STATION=""
RESET_MODE=""
for arg in "$@"; do
  case "$arg" in
    --reset-34) RESET_MODE="34" ;;
    --reset-full|--reset) RESET_MODE="full" ;;
    -h|--help) STATION="" ;;
    -*)
      echo "未知参数: $arg" >&2
      exit 2
      ;;
    *)
      if [[ -z "$STATION" ]]; then
        STATION="$arg"
      else
        echo "多余参数: $arg" >&2
        exit 2
      fi
      ;;
  esac
done

if [[ -z "$STATION" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
用法: ego-deliver <station> [选项]

录完后在 34 上执行的唯一交付命令:
  1. 边缘 ego-upload（幂等上传待传 segment）
  2. 34 ego-process（derive 批量 + convert + 轻量 Viewer sync）

示例:
  ego-deliver ego-001
  ego-deliver ego-001 --reset-34    # 仅清 34，从边缘重传
  ego-deliver ego-001 --reset-full  # 清边缘 + 34（慎用）

也可分步执行:
  130:  ego-upload ego-001
  34:   ego-process ego-001

环境变量:
  EDGE_HOST            默认 server@10.10.10.130（ego-001）
  EGO_RESET_YES=1      跳过 reset 确认
EOF
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATALAB_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
EDGE_HOST="${EDGE_HOST:-server@10.10.10.130}"
PLATFORM_HOST="${LABEL_STUDIO_HOST:-http://10.10.10.34:8080}"
PLATFORM_HOST="${PLATFORM_HOST%/}"

log() { echo "[deliver] $*"; }
die() { echo "[deliver] ERROR: $*" >&2; exit 1; }

SLUG="$(python3 "${SCRIPT_DIR}/ego-pipeline-sessions.py" slug "$STATION" \
  --datalab-root "$DATALAB_ROOT" 2>/dev/null || echo "ego_001")"
MANIFEST_ID="$(python3 "${SCRIPT_DIR}/ego-pipeline-sessions.py" manifest-id "$STATION" \
  --datalab-root "$DATALAB_ROOT" 2>/dev/null || echo "ego-001")"
VIEWER_URL="${PLATFORM_HOST}/data/${MANIFEST_ID}"

if [[ "$RESET_MODE" == "34" ]]; then
  log "=== 0/2 清场 (仅 34) ==="
  STATION_ID="$STATION" EGO_RESET_YES="${EGO_RESET_YES:-}" bash "${SCRIPT_DIR}/ego-reset-34-only.sh"
elif [[ "$RESET_MODE" == "full" ]]; then
  log "=== 0/2 清场 (边缘 + 34) ==="
  STATION_ID="$STATION" EGO_RESET_YES="${EGO_RESET_YES:-}" bash "${SCRIPT_DIR}/ego-001-reset-for-rerun.sh" --yes
fi

log "=== 1/2 边缘上传 (ego-upload) ==="
if ssh -o BatchMode=yes "${EDGE_HOST}" "command -v ego-upload >/dev/null 2>&1"; then
  ssh -o BatchMode=yes "${EDGE_HOST}" "ego-upload ${STATION}"
else
  log "边缘未安装 ego-upload，回退 inline upload_segments"
  ssh -o BatchMode=yes "${EDGE_HOST}" bash -s -- "${STATION}" <<'REMOTE'
set -euo pipefail
STATION="$1"
set -a
source "$HOME/.config/ego-station.env" 2>/dev/null || true
source "$HOME/.config/ego-station.env.d/station.conf" 2>/dev/null || true
set +a
PY="${EGO_PYTHON:-/home/server/workspace/ego-studio/.venv/bin/python}"
SEG_ROOT="${EGO_SEGMENT_ROOT:-/home/server/cache/${STATION}/segments}"
UPLOAD_URL="${EGO_UPLOAD_URL:-http://10.10.10.34:8080/lerobot/api/collection/stations/${STATION}/upload}"
export PYTHONPATH="${EGO_CAPTURE_SRC:-/home/server/workspace/ego-studio/src}${PYTHONPATH:+:$PYTHONPATH}"
"$PY" -m ego_capture_studio.cli.upload_segments \
  --limit 0 \
  --ensure-session \
  --segment-root "$SEG_ROOT" \
  --upload-url "$UPLOAD_URL"
REMOTE
fi

log "=== 2/2 34 派生 + 后处理 + Viewer (ego-process) ==="
bash "${SCRIPT_DIR}/ego-process" "$STATION"

log "交付完成 → ${VIEWER_URL}"
