[Unit]
Description=Continuous EGO segment upload dequeue (keep pending below target)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/home/server/workspace/ego-studio
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/server/workspace/ego-studio/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=STATION_UPLOAD_TOKEN=dl-upload-ego-lan-214-v1
Environment=EGO_SEGMENT_ROOT=/home/server/cache/ego-lan-214/segments
Environment=EGO_SEGMENT_DELETE_AFTER_UPLOAD=0
Environment=EGO_SOAK_ARCHIVE_DIR=/tmp/strict20hz_soak_archive
Environment=DATALAB_UPLOAD_TIMEOUT_S=600
Environment=EGO_UPLOAD_KEEP_PENDING_BELOW=30
Environment=EGO_UPLOAD_POLL_INTERVAL_S=8
Environment=EGO_UPLOAD_BURST_LIMIT=40
Environment=EGO_UPLOAD_SUBPROC_TIMEOUT_S=90
Environment=EGO_UPLOAD_FAIL_DEQUEUE=1
Environment=EGO_UPLOAD_URL=http://10.10.10.34:8080/lerobot/api/collection/stations/ego-lan-214/upload

ExecStart=/home/server/workspace/ego-studio/.venv/bin/python /home/server/workspace/ego-studio/src/ego_capture_studio/tools/upload_segments_loop.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecs-upload-loop
