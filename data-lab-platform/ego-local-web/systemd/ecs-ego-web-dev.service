[Unit]
Description=EGO change_view test web (port 8082)
Documentation=file:///home/server/ego-web-dev/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/server/ego-web-dev
EnvironmentFile=-%h/.config/ego-station.env
Environment=PYTHONUNBUFFERED=1
Environment=EGO_WEB_HOST=0.0.0.0
Environment=EGO_WEB_PORT=8082
Environment=EGO_WEB_UI_MODE=change_view
Environment=EGO_CAPTURE_TARGET=ecs-oak-mcap-capture-stack.target
Environment=EGO_STANDBY_IDLE_STOP_S=45
ExecStart=/usr/bin/python3 /home/server/ego-web-dev/ego_web.py
Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecs-ego-web-dev

[Install]
WantedBy=default.target
