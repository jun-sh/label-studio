FROM python:3.11-slim

RUN pip install --no-cache-dir pyarrow \
  -i https://pypi.tuna.tsinghua.edu.cn/simple \
  --default-timeout=120

COPY scripts/sync-stream-parquet.py /scripts/sync-stream-parquet.py
COPY scripts/stream-parquet-sync-loop.sh /scripts/stream-parquet-sync-loop.sh

ENV STREAM_SYNC_INTERVAL=5

RUN chmod +x /scripts/stream-parquet-sync-loop.sh

CMD ["/scripts/stream-parquet-sync-loop.sh"]
