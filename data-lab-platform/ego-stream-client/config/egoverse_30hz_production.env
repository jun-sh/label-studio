# EgoVerse 30/200 production reference (ego-lan-214).
# Sign-off: config/egoverse_30hz_production_signoff.json

# --- ecs-record-oak-stream (z-production-egoverse.conf) ---
EGO_FRAME_INTERVAL_MS=33
EGO_IMU_INTERPOLATE=1
EGO_CAPTURE_FPS=30
EGO_CAPTURE_IMU_HZ=200
EGO_STRICT_EPISODE_SECONDS=86400
EGO_CAPTURE_NO_HEARTBEAT=1
STRICT_IMU_BUFFER_MAX=4000
STRICT_SYNC_MISS_MAX=32
SEGMENT_AUTO_PURGE_PENDING=1
SEGMENT_BACKPRESSURE_PENDING=1
EGO_PENDING_FAST_RESCAN_S=20

# --- ecs-upload-segments-loop ---
EGO_UPLOAD_KEEP_PENDING_BELOW=18
EGO_UPLOAD_TRIM_BATCH=2
EGO_SEGMENT_ASYNC_DELETE=1
EGO_UPLOAD_FAIL_DEQUEUE=1
EGO_SEGMENT_DELETE_AFTER_UPLOAD=1

# --- ecs-station-heartbeat ---
DATALAB_HEARTBEAT_INTERVAL_S=15
DATALAB_HEARTBEAT_TIMEOUT_S=3
DATALAB_HEARTBEAT_NICE=10

# --- 34 stream-ingest ---
STREAM_MUX_FPS=30
