    },
    {
      "id": "place",
      "order": 6,
      "color": "#A78BFA",
      "label_zh": "放置",
      "label_en": "Place",
      "hint_zh": "朝传送带下降，未松手",
      "hint_en": "Lowering onto conveyor, not released"
    },
    {
      "id": "release",
      "order": 7,
      "color": "#F472B6",
      "label_zh": "释放",
      "label_en": "Release",
      "hint_zh": "松手，箱脱离",
      "hint_en": "Gripper opens, box detached"
    }
