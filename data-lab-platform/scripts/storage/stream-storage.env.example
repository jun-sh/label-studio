# Copy to /opt/datalab/env/stream-storage.env on 10.10.10.34 and source from cron scripts.
# Adjust volume mount path if your Docker project name differs.

STATION_ID=ego-001
STREAM_DATA_ROOT=/srv/stream
STATION_ROOT=/media/user01/7234c6f9-112e-4b82-925d-7b86065a5f4a/workspace/data-lab/data-storage/stream/ego-001
STREAM_VOL_ROOT=/media/user01/7234c6f9-112e-4b82-925d-7b86065a5f4a/workspace/data-lab/data-storage/stream
DATALAB_STORAGE_ROOT=/media/user01/7234c6f9-112e-4b82-925d-7b86065a5f4a/workspace/data-lab/data-storage

# Cold archive under repo data-storage/
COLD_ROOT=/media/user01/7234c6f9-112e-4b82-925d-7b86065a5f4a/workspace/data-lab/data-storage/ego-archive

# Pack hot archive/ dirs older than 7 days (hours)
HOT_ARCHIVE_MIN_AGE_HOURS=168

# Hot tier target (GB) — per-station ingest + hot-tier-enforce.sh
STREAM_QUOTA_GB=400
STREAM_QUOTA_GB_EGO_LAN_214=400

# Combined hot+cold cap (enforce-storage-quota.sh)
DATALAB_STORAGE_QUOTA_GB=512
DATALAB_STORAGE_HIGH_WATER_GB=480
HOT_QUOTA_BYTES=$((STREAM_QUOTA_GB * 1024 * 1024 * 1024))
HOT_HIGH_WATER_PERCENT=90

# Max session archives moved to cold per cron run (session-level, no full-tree walk)
COLD_MIGRATE_MAX_PER_RUN=3
