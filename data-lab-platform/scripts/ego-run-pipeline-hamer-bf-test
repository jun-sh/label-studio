#!/usr/bin/env bash
# Test wrapper: ego hand post-process with HaMeR doc Butterworth temporal smoothing.
# Does NOT change main/release defaults — only active when invoked explicitly.
#
# Replaces the per-side temporal smooth step (One-Euro MANO) with:
#   missing-frame interp → wrist outlier reject → Butterworth low-pass on 2D/3D joints
# See: data-lab-platform/docs/ego-hamer-bf-test-runbook.md
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DATALAB_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
PLATFORM_ROOT="${EGO_PLATFORM_ROOT:-$(dirname "$DATALAB_ROOT")/ego-platform}"

export EGO_PIPELINE_BACKEND="${EGO_PIPELINE_BACKEND:-oak}"
export EGO_OAK_MODE="${EGO_OAK_MODE:-hands}"
export EGO_HAMER_BACKEND="${EGO_HAMER_BACKEND:-geopavlakos}"

# HaMeR doc postprocess_joints.py defaults (override via env before calling).
export EGO_HANDS_TEMPORAL_SMOOTH="${EGO_HANDS_TEMPORAL_SMOOTH:-butterworth}"
export EGO_HANDS_BF_FS="${EGO_HANDS_BF_FS:-30}"
export EGO_HANDS_BF_LOWCUT="${EGO_HANDS_BF_LOWCUT:-8.0}"
export EGO_HANDS_BF_DELTA="${EGO_HANDS_BF_DELTA:-12}"
export EGO_HANDS_BF_ORDER="${EGO_HANDS_BF_ORDER:-3}"
export EGO_HANDS_BF_OUTLIER_3D="${EGO_HANDS_BF_OUTLIER_3D:-0.12}"
export EGO_HANDS_BF_OUTLIER_2D="${EGO_HANDS_BF_OUTLIER_2D:-80}"

if [[ ! -d "$PLATFORM_ROOT" ]]; then
  echo "❌ ego-platform not found: $PLATFORM_ROOT" >&2
  echo "   checkout test/hamer-joints-bf-postprocess in sibling ego-platform" >&2
  exit 1
fi

branch="$(git -C "$PLATFORM_ROOT" branch --show-current 2>/dev/null || true)"
if [[ "$branch" != "test/hamer-joints-bf-postprocess" ]]; then
  echo "⚠️  ego-platform is on branch '${branch:-?}', expected test/hamer-joints-bf-postprocess" >&2
  echo "   cd $PLATFORM_ROOT && git checkout test/hamer-joints-bf-postprocess" >&2
fi

echo "[hamer-bf-test] temporal_smooth=$EGO_HANDS_TEMPORAL_SMOOTH lowcut=$EGO_HANDS_BF_LOWCUT delta=$EGO_HANDS_BF_DELTA"
echo "[hamer-bf-test] ego-platform=$PLATFORM_ROOT"

exec "${SCRIPT_DIR}/ego-run-pipeline" "$@"
